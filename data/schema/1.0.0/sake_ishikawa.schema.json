{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://find-sake.me/open-data/schema/1.0.0/sake_ishikawa.schema.json",
  "title": "Ishikawa Sake Taste Data (Sake-Musubi)",
  "description": "JSON Schema for ishikawa-sake-data-sakemusubi 1.0.0. Data: https://find-sake.me/open-data/sake_ishikawa.json",
  "type": "object",
  "required": [
    "dataset",
    "title",
    "description",
    "schema_version",
    "schema_url",
    "version",
    "issued",
    "generated_at",
    "license",
    "license_url",
    "attribution",
    "publisher",
    "contact_url",
    "homepage",
    "language",
    "spatial",
    "record_count",
    "brewery_count",
    "brewery_confirmed_count",
    "notes",
    "axes",
    "categories",
    "aroma_types",
    "acidity_types",
    "tags",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "const": "ishikawa-sake-data-sakemusubi"
    },
    "title": {
      "type": "object",
      "required": [
        "ja",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "description": {
      "type": "object",
      "required": [
        "ja",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Structure version (semver). major = removed / renamed / re-meant columns, minor = added columns, patch = wording only"
    },
    "schema_url": {
      "type": "string",
      "format": "uri",
      "description": "This schema (versioned URL)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(\\.\\d+)?$",
      "description": "Data version = release date (JST). One version = one set of files; a re-release on the same day gets a .1 suffix"
    },
    "issued": {
      "type": "string",
      "format": "date",
      "description": "First release date of the dataset"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Build time (UTC)"
    },
    "license": {
      "const": "CC-BY-4.0"
    },
    "license_url": {
      "type": "string",
      "format": "uri"
    },
    "attribution": {
      "type": "object",
      "required": [
        "ja",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "description": "Recommended attribution text"
    },
    "publisher": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "object",
          "required": [
            "ja",
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "ja": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "contact_url": {
      "type": "string",
      "format": "uri"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "language": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Languages of labels (BCP 47). Free-text values are Japanese"
    },
    "spatial": {
      "type": "string",
      "description": "ISO 3166-2 code of the covered region"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "brewery_count": {
      "type": "integer",
      "minimum": 0
    },
    "brewery_confirmed_count": {
      "type": "object",
      "required": [
        "spec",
        "taste"
      ],
      "additionalProperties": false,
      "properties": {
        "spec": {
          "type": "integer"
        },
        "taste": {
          "type": "integer"
        }
      }
    },
    "notes": {
      "type": "object",
      "required": [
        "ja",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "en": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Caveats that travel with the file"
    },
    "axes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scale",
          "label",
          "levels"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "sweet_dry",
              "acidity",
              "umami",
              "aroma",
              "body",
              "finish",
              "drinkability"
            ]
          },
          "scale": {
            "type": "object",
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false,
            "properties": {
              "min": {
                "const": 1
              },
              "max": {
                "const": 5
              }
            }
          },
          "label": {
            "type": "object",
            "required": [
              "ja",
              "en",
              "fr",
              "it",
              "de",
              "ko",
              "zh-TW",
              "zh-CN"
            ],
            "additionalProperties": false,
            "properties": {
              "ja": {
                "type": "string"
              },
              "en": {
                "type": "string"
              },
              "fr": {
                "type": "string"
              },
              "it": {
                "type": "string"
              },
              "de": {
                "type": "string"
              },
              "ko": {
                "type": "string"
              },
              "zh-TW": {
                "type": "string"
              },
              "zh-CN": {
                "type": "string"
              }
            }
          },
          "levels": {
            "type": "object",
            "required": [
              "ja",
              "en",
              "fr",
              "it",
              "de",
              "ko",
              "zh-TW",
              "zh-CN"
            ],
            "additionalProperties": false,
            "properties": {
              "ja": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 5,
                "maxItems": 5
              },
              "en": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 5,
                "maxItems": 5
              },
              "fr": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 5,
                "maxItems": 5
              },
              "it": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 5,
                "maxItems": 5
              },
              "de": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 5,
                "maxItems": 5
              },
              "ko": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 5,
                "maxItems": 5
              },
              "zh-TW": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 5,
                "maxItems": 5
              },
              "zh-CN": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 5,
                "maxItems": 5
              }
            }
          }
        }
      },
      "description": "The 7 taste axes: labels and the wording of levels 1–5 in 8 languages"
    },
    "categories": {
      "type": "array",
      "description": "Designation codes for records[].category. source_values = label wording mapped to the code",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_values",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "source_values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "label": {
            "type": "object",
            "required": [
              "ja",
              "en",
              "fr",
              "it",
              "de",
              "ko",
              "zh-TW",
              "zh-CN"
            ],
            "additionalProperties": false,
            "properties": {
              "ja": {
                "type": "string"
              },
              "en": {
                "type": "string"
              },
              "fr": {
                "type": "string"
              },
              "it": {
                "type": "string"
              },
              "de": {
                "type": "string"
              },
              "ko": {
                "type": "string"
              },
              "zh-TW": {
                "type": "string"
              },
              "zh-CN": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "aroma_types": {
      "type": "array",
      "description": "Codes for records[].aroma_type. code = the letter used on the Sake-Musubi site",
      "items": {
        "type": "object",
        "required": [
          "id",
          "code",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-E]$"
          },
          "label": {
            "type": "object",
            "required": [
              "ja",
              "en",
              "fr",
              "it",
              "de",
              "ko",
              "zh-TW",
              "zh-CN"
            ],
            "additionalProperties": false,
            "properties": {
              "ja": {
                "type": "string"
              },
              "en": {
                "type": "string"
              },
              "fr": {
                "type": "string"
              },
              "it": {
                "type": "string"
              },
              "de": {
                "type": "string"
              },
              "ko": {
                "type": "string"
              },
              "zh-TW": {
                "type": "string"
              },
              "zh-CN": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "acidity_types": {
      "type": "array",
      "description": "Codes for records[].acidity_type (sensory classification)",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "object",
            "required": [
              "ja",
              "en",
              "fr",
              "it",
              "de",
              "ko",
              "zh-TW",
              "zh-CN"
            ],
            "additionalProperties": false,
            "properties": {
              "ja": {
                "type": "string"
              },
              "en": {
                "type": "string"
              },
              "fr": {
                "type": "string"
              },
              "it": {
                "type": "string"
              },
              "de": {
                "type": "string"
              },
              "ko": {
                "type": "string"
              },
              "zh-TW": {
                "type": "string"
              },
              "zh-CN": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "description": "Codes for records[].tags",
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "basis",
          "source_columns",
          "patterns",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "enum": [
              "method",
              "state"
            ]
          },
          "basis": {
            "type": "string",
            "enum": [
              "text",
              "record"
            ],
            "description": "text = derived from the listed free-text columns by substring match (reproducible); record = from Sake-Musubi's own record, not reproducible from the file"
          },
          "source_columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "label": {
            "type": "object",
            "required": [
              "ja",
              "en",
              "fr",
              "it",
              "de",
              "ko",
              "zh-TW",
              "zh-CN"
            ],
            "additionalProperties": false,
            "properties": {
              "ja": {
                "type": "string"
              },
              "en": {
                "type": "string"
              },
              "fr": {
                "type": "string"
              },
              "it": {
                "type": "string"
              },
              "de": {
                "type": "string"
              },
              "ko": {
                "type": "string"
              },
              "zh-TW": {
                "type": "string"
              },
              "zh-CN": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "public_id",
        "url",
        "name",
        "name_kana",
        "name_romaji",
        "brewery",
        "category",
        "rice",
        "polishing_ratio_pct",
        "polishing_by_rice",
        "abv_pct",
        "sake_meter_value",
        "titratable_acidity",
        "ranges",
        "yeast",
        "water_source",
        "starter_method",
        "pressing_filtration",
        "pasteurization",
        "undisclosed",
        "aroma_type",
        "acidity_type",
        "tags",
        "taste",
        "volumes_ml",
        "brewery_confirmed",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "public_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Sake-Musubi public ID. Stable: never reassigned or changed. Same as the /sake/{public_id} URL"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Sake page on Sake-Musubi"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name as on the label (Japanese)"
        },
        "name_kana": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reading in kana"
        },
        "name_romaji": {
          "type": [
            "string",
            "null"
          ],
          "description": "Name in romaji"
        },
        "brewery": {
          "type": "object",
          "required": [
            "id",
            "name",
            "name_romaji",
            "url",
            "website"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1,
              "description": "Brewery public ID. Stable"
            },
            "name": {
              "type": "string",
              "description": "Brewery name (Japanese)"
            },
            "name_romaji": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Brewery page on Sake-Musubi"
            },
            "website": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri",
              "description": "Official website (http(s) only)"
            }
          }
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "junmai_daiginjo",
            "daiginjo",
            "junmai_ginjo",
            "ginjo",
            "tokubetsu_junmai",
            "junmai",
            "tokubetsu_honjozo",
            "honjozo",
            "futsushu",
            null
          ],
          "description": "Designation code (see categories). null = not stated on the label"
        },
        "rice": {
          "type": [
            "string",
            "null"
          ],
          "description": "Rice, free text as written (may include origin, ratio, koji/kake role)"
        },
        "polishing_ratio_pct": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100,
          "description": "Rice polishing ratio (%). Average of koji and kake when they differ (see polishing_by_rice)"
        },
        "polishing_by_rice": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "koji",
            "kake"
          ],
          "additionalProperties": false,
          "properties": {
            "koji": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "kake": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "description": "Polishing ratio per rice role when the label states them separately; null otherwise"
        },
        "abv_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 30,
          "description": "Alcohol by volume (%). Midpoint when the label gives a range (see ranges)"
        },
        "sake_meter_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -100,
          "maximum": 40,
          "description": "Sake meter value (nihonshu-do), signed; positive = drier. Midpoint for ranges"
        },
        "titratable_acidity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10,
          "description": "Titratable acidity (sando) as published by the brewery. Not the taste axis taste.acidity"
        },
        "ranges": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "abv_pct": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[min, max]"
            },
            "sake_meter_value": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[min, max]"
            },
            "titratable_acidity": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[min, max]"
            }
          },
          "description": "Original range for a value given as a range on the label; the record value is the midpoint. Keys present only when a range exists"
        },
        "yeast": {
          "type": [
            "string",
            "null"
          ],
          "description": "Yeast, free text"
        },
        "water_source": {
          "type": [
            "string",
            "null"
          ],
          "description": "Brewing water, free text"
        },
        "starter_method": {
          "type": [
            "string",
            "null"
          ],
          "description": "Starter (moto) method and related notes, free text. null does not mean sokujo"
        },
        "pressing_filtration": {
          "type": [
            "string",
            "null"
          ],
          "description": "Pressing / filtration, free text"
        },
        "pasteurization": {
          "type": [
            "string",
            "null"
          ],
          "description": "Pasteurization / storage / dilution notes, free text"
        },
        "undisclosed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sake_meter_value",
              "titratable_acidity",
              "polishing_ratio_pct",
              "abv_pct",
              "category",
              "rice",
              "yeast",
              "water_source",
              "starter_method",
              "pressing_filtration",
              "pasteurization",
              "acidity_type",
              "aroma_type"
            ]
          },
          "uniqueItems": true,
          "description": "Fields the brewery intentionally does not disclose. Any other null means \"not found in the sources\""
        },
        "aroma_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "melon_peach",
            "green_apple_lemon",
            "banana",
            "matured",
            "grain",
            null
          ],
          "description": "Aroma type code (see aroma_types)"
        },
        "acidity_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "lactic",
            "malic",
            "balanced",
            null
          ],
          "description": "Acidity style code, sensory classification (see acidity_types)"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "yamahai",
              "kimoto",
              "sokujo",
              "kijoshu",
              "muroka",
              "nigori",
              "origarami",
              "arabashiri",
              "nakadori",
              "shizuku",
              "henpei",
              "nama",
              "genshu",
              "namachozo",
              "hiyaoroshi",
              "koshu",
              "sparkling"
            ]
          },
          "uniqueItems": true,
          "description": "Method / condition tags (see tags). Empty = no matching wording, not \"pasteurised / diluted / still\""
        },
        "taste": {
          "type": "object",
          "required": [
            "sweet_dry",
            "acidity",
            "umami",
            "aroma",
            "body",
            "finish",
            "drinkability"
          ],
          "additionalProperties": false,
          "properties": {
            "sweet_dry": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5
            },
            "acidity": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5
            },
            "umami": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5
            },
            "aroma": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5
            },
            "body": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5
            },
            "finish": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5
            },
            "drinkability": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5
            }
          },
          "description": "7 taste axes (1–5, ordinal). Estimated by Sake-Musubi"
        },
        "volumes_ml": {
          "type": "array",
          "items": {
